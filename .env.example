# Vapi (dashboard.vapi.ai → API keys)
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# Google Gemini key used by the n8n scoring step (aistudio.google.com)
GEMINI_API_KEY=
# HubSpot private app token (Settings → Integrations → Private Apps) — scopes: crm.objects.contacts.read/write, crm.schemas.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=
# Slack incoming webhook for lead alerts
SLACK_WEBHOOK_URL=
# Where the Gmail digest goes
SALES_EMAIL=
# Google Sheet id for the lead ledger (sheet tab must be named "Leads")
SHEET_ID=
# Google Calendar to read/book ("primary" or a calendar id)
SALES_CALENDAR_ID=primary
# n8n credential ids (from the n8n UI URL when editing the credential)
HUBSPOT_CRED_ID=
GCAL_CRED_ID=
# Public n8n base URL, no trailing slash — used for Vapi tools + end-of-call webhook
N8N_WEBHOOK_BASE=https://your-n8n-host/webhook
